# ==========================================
# LIFORA - Environment Configuration
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3005

# ------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL / Supabase)
# ------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use Transaction Pooler (port 6543) for DATABASE_URL in serverless environments (Vercel)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use Direct Connection (port 5432) for migrations (DIRECT_URL)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------
# SUPABASE CONFIGURATION (Auth & Realtime)
# ------------------------------------------
# Find these in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service role key for admin tasks (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# CRON & BACKGROUND JOBS
# ------------------------------------------
# Secret key used to verify Vercel Cron requests hitting /api/cron/*
CRON_SECRET=your-random-32-byte-cron-secret-here

# ------------------------------------------
# RESEND CONFIGURATION (Email Notifications)
# ------------------------------------------
# Find this in your Resend Dashboard: API Keys
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=notifications@lifora.care

# ------------------------------------------
# AI CARE ASSISTANT
# ------------------------------------------
# Optional: OpenAI / Gemini API key for dynamic contextual insights
# (LIFORA includes built-in contextual rule & analysis engine fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
