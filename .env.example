# ==========================================
# LIFORA - Environment Configuration
# ==========================================

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------
# SUPABASE CONFIGURATION (Database & Auth)
# ------------------------------------------
# Find these in your Supabase Dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Optional: Service role key for administrative tasks (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------
# RESEND CONFIGURATION (Email Notifications)
# ------------------------------------------
# Find this in your Resend Dashboard: API Keys
RESEND_API_KEY=re_123456789_abcdefg
RESEND_FROM_EMAIL=notifications@lifora.care

# ------------------------------------------
# AI CARE ASSISTANT
# ------------------------------------------
# Optional: OpenAI / Gemini API key for dynamic contextual insights
# (LIFORA includes built-in contextual rule & analysis engine fallback)
OPENAI_API_KEY=
GEMINI_API_KEY=
