generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. PROFILES (Elderly, Family, Caretaker)
model Profile {
  id                String    @id @default(uuid()) @db.Uuid
  email             String?   @unique
  role              String    @db.VarChar(20) // 'elderly' | 'family' | 'caretaker'
  fullName          String    @map("full_name")
  preferredName     String    @map("preferred_name")
  age               Int?
  dob               DateTime? @db.Date
  bloodType         String?   @map("blood_type") @db.VarChar(10)
  avatarUrl         String?   @map("avatar_url")
  phone             String?   @db.VarChar(30)
  address           String?
  timezone          String    @default("America/Los_Angeles") @db.VarChar(50)
  primaryConditions String[]  @default([]) @map("primary_conditions")
  knownAllergies    String[]  @default([]) @map("known_allergies")
  emergencyContact  Json      @default("{}") @map("emergency_contact")
  primaryPhysician  Json      @default("{}") @map("primary_physician")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  medications            Medication[]
  doseLogs               DoseLog[]
  appointments           Appointment[]
  careCircleAsRecipient  CareCircleMember[] @relation("ElderlyRecipient")
  careCircleAsMember     CareCircleMember[] @relation("MemberUser")
  notifications          CareNotification[]
  auditEvents            AuditEvent[]

  @@index([role])
  @@index([phone])
  @@map("profiles")
}

// 2. MEDICATIONS (Prescription Registry)
model Medication {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  name              String
  genericName       String?   @map("generic_name")
  dosage            String
  form              String    @db.VarChar(30) // 'tablet', 'capsule', 'liquid', 'inhaler', 'injection', 'drops', 'topical'
  color             String?   @default("#2E847D") @db.VarChar(20)
  purpose           String
  frequency         String    @db.VarChar(30) // 'daily', 'twice_daily', 'three_times_daily', 'four_times_daily', 'weekly', 'as_needed'
  scheduleTimes     String[]  @default(["08:00 AM"]) @map("schedule_times")
  withFood          String    @map("with_food") @db.VarChar(20) // 'before', 'with', 'after', 'anytime'
  instructions      String    @default("")
  prescribingDoctor String    @default("") @map("prescribing_doctor")
  refillCount       Int       @default(0) @map("refill_count")
  totalQuantity     Int       @default(30) @map("total_quantity")
  active            Boolean   @default(true)
  startDate         DateTime  @default(now()) @map("start_date") @db.Date
  endDate           DateTime? @map("end_date") @db.Date
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  profile  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  doseLogs DoseLog[]

  @@index([userId])
  @@index([userId, active])
  @@map("medications")
}

// 3. DOSE LOGS (Daily Doses & Administration Status)
model DoseLog {
  id            String    @id @default(uuid()) @db.Uuid
  medicationId  String    @map("medication_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  scheduledDate DateTime  @map("scheduled_date") @db.Date
  scheduledTime String    @map("scheduled_time") @db.VarChar(30) // e.g. "08:00 AM"
  status        String    @default("pending") @db.VarChar(20) // 'pending' | 'taken' | 'missed' | 'snoozed'
  takenAt       DateTime? @map("taken_at") @db.Timestamptz()
  takenBy       String?   @map("taken_by") @db.Uuid
  recordedBy    String?   @map("recorded_by")
  missedReason  String?   @map("missed_reason")
  snoozeUntil   DateTime? @map("snooze_until") @db.Timestamptz()
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  profile    Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([medicationId, scheduledDate, scheduledTime])
  @@index([userId, scheduledDate])
  @@index([status])
  @@map("dose_logs")
}

// 4. CARE CIRCLE MEMBERS (Family & Caretakers Link)
model CareCircleMember {
  id                   String   @id @default(uuid()) @db.Uuid
  elderlyUserId        String   @map("elderly_user_id") @db.Uuid
  memberUserId         String?  @map("member_user_id") @db.Uuid
  name                 String
  relation             String   @db.VarChar(40) // 'Daughter', 'Son', 'Spouse', 'Primary Caregiver', 'Home Nurse', etc.
  role                 String   @db.VarChar(20) // 'family' | 'caretaker'
  phone                String   @db.VarChar(30)
  email                String
  isEmergencyContact   Boolean  @default(false) @map("is_emergency_contact")
  canManageMeds        Boolean  @default(true) @map("can_manage_meds")
  receiveInstantAlerts Boolean  @default(true) @map("receive_instant_alerts")
  avatarUrl            String?  @map("avatar_url")
  inviteStatus         String   @default("accepted") @map("invite_status") @db.VarChar(20) // 'invited' | 'accepted' | 'declined'
  lastActiveAt         DateTime @default(now()) @map("last_active_at") @db.Timestamptz()
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  elderly    Profile  @relation("ElderlyRecipient", fields: [elderlyUserId], references: [id], onDelete: Cascade)
  memberUser Profile? @relation("MemberUser", fields: [memberUserId], references: [id], onDelete: SetNull)

  @@unique([elderlyUserId, email])
  @@index([elderlyUserId])
  @@index([memberUserId])
  @@map("care_circle_members")
}

// 5. APPOINTMENTS (Clinical Consultations & Escorts)
model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  doctorName      String   @map("doctor_name")
  specialty       String
  facility        String
  address         String   @default("")
  contactNumber   String   @default("") @map("contact_number") @db.VarChar(30)
  appointmentDate DateTime @map("appointment_date") @db.Date
  appointmentTime String   @map("appointment_time") @db.VarChar(30)
  notes           String?
  requiresEscort  Boolean  @default(true) @map("requires_escort")
  assignedEscort  String?  @map("assigned_escort")
  status          String   @default("upcoming") @db.VarChar(20) // 'upcoming', 'completed', 'rescheduled', 'cancelled'
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, appointmentDate])
  @@map("appointments")
}
